# ── Flask / App core ─────────────────────────────────────────────────────────
# Secret used to sign session JWTs and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Application environment: development | production
FLASK_ENV=development
# When true, Flask runs its debug server with the auto-reloader (dev only).
FLASK_DEBUG=0
# Public base URL of the web app, e.g. https://freedom-for-dance.onrender.com
# Used to build the OAuth redirect URI. Omit the trailing slash.
BASE_URL=http://localhost:5000

# ── Discord application (https://discord.com/developers/applications) ────────
# OAuth2 client credentials ("Discord Client ID" / "Discord Client Secret").
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token from the "Bot" tab. Required for the bot thread, admin live
# re-verification of permissions, and channel lists. Empty = bot stays offline.
DISCORD_BOT_TOKEN=
# The single guild (server) this app serves. Right-click the server name →
# Copy Server ID.
DISCORD_GUILD_ID=
# ID of the text channel announcements are broadcast to, if you don't want
# admins to pick a channel at publish time. Optional.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
# ID of the channel where tier-2/tier-3 moderation alerts are posted.
# Optional — falls back to the guild's system channel.
DISCORD_MODERATION_CHANNEL_ID=
# Space-separated list of role IDs whose mentions count as "mod ping" for
# tier-3 moderation alerts. Optional.
MODERATOR_ROLE_IDS=

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Full connection string, e.g. postgresql://user:pass@host/db?sslmode=require.
# Leave unset in local dev to fall back to a local SQLite file (dev.db).
DATABASE_URL=

# ── Groq (AI moderation) ─────────────────────────────────────────────────────
# API key from https://console.groq.com. Empty = moderation listener is idle.
GROQ_API_KEY=
# Model used for moderation classification. Keep this on a fast Llama variant.
GROQ_MODEL=llama-3.1-8b-instant
# Consecutive failures before the moderation circuit breaker opens (log-only).
GROQ_CIRCUIT_FAILURE_THRESHOLD=3
# Seconds the breaker stays open before it allows a test call again.
GROQ_CIRCUIT_COOLDOWN_SECONDS=300
# Hard timeout for a single classification call, in seconds.
GROQ_TIMEOUT_SECONDS=5

# ── Lavalink (music playback) ────────────────────────────────────────────────
# Address of the Lavalink node, e.g. http://localhost:2333.
LAVALINK_URI=http://localhost:2333
# Password configured on the Lavalink node.
LAVALINK_PASSWORD=youmustchangethis

# ── Auth / session ───────────────────────────────────────────────────────────
# JWT lifetime for the session cookie, in hours.
JWT_TTL_HOURS=12
# Re-issue the cookie when less than this many hours remain (silent refresh).
JWT_REFRESH_AFTER_HOURS=6
# Max age of the live admin-permission cache, in seconds (see README §3.2).
ADMIN_CHECK_CACHE_SECONDS=300

# ── Observability ────────────────────────────────────────────────────────────
# Sentry DSN. Leave empty to disable Sentry entirely (clean no-op).
SENTRY_DSN=
